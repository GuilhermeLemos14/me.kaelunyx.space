---
import Layout from "@/layouts/Layout.astro";
import PronounsLink from "@/components/PronounsLink.astro";
import Footer from "@/components/Footer.astro";

import { moreAbout, pronouns, languages } from "@/data/about";
import calculateAge from "@/utils/age";

const title = "About — Me Kaelunyx Space";
const description =
	"Kaelunyx — artist, fullstack web developer, and musician. A personal universe shaped by cosmic aesthetics and digital creativity.";
const nofooter = true;
---

<Layout {title} {description} {nofooter}>
	<div class="about-div">
		<header class="px-18 py-10 text-center">
			<h1 class="mb-3 text-4xl">Hi, I'm Kaelunyx</h1>
			<p class="my-4">
				I'm a bit too much for a simple website. Everything here is just
				the essentials... <em>for now.</em>
			</p>
			<nav class="about-nav">
				{
					[
						{
							title: "Home",
							href: "/",
						},
						{
							title: "Contact",
							href: "/contact/",
						},
						{
							title: "Credits",
							href: "/credits/",
						},
					].map(({ title, href }) => (
						<a class="page-link" {href}>
							{title}
						</a>
					))
				}
			</nav>
		</header>
		<main class="px-5">
			<section class="about-section" id="about">
				<h2 class="text-cosmic-adaptive-purple my-4 text-2xl">
					About me
				</h2>
				<p>
					Hi, my name is Mikael Bélanger, known online as
					<abbr title="Kaelunyx Sylen Rivenheart">Kaelunyx</abbr>.
				</p>
				<p>
					I'm {calculateAge()} years old and the developer of this entire
					website lol
				</p>
				<p>
					I live in Brazil, more specifically in the Northeast region.
					I dream of living in Canada one day.
				</p>
				<ul class="mx-0 my-3">
					{
						/* I have a deep love for cosmic aesthetics, which influences my art,
						music, and even my style. I find beauty in the vastness of space and
						the mysteries it holds. */
						moreAbout.map(({ title, description }) => (
							<li>
								<p class="strong-paragraph">
									<strong class="text-cosmic-adaptive-blue">
										{title}:
									</strong>{" "}
									{description}
								</p>
							</li>
						))
					}
				</ul>
				<p class="mx-8 text-center">
					P.S. I honestly had no idea what to write here when I
					started this page. Now it's huge. Still, if something's
					missing — just ask.
				</p>
				<p class="strong-paragraph">
					<strong>My alarm</strong>
				</p>
				<div class="iframe-wrapper">
					<iframe
						title="My Alarm"
						src="https://open.spotify.com/embed/track/0tKVPaVz1PzHUXafgfvm35?utm_source=generator"
						width="100%"
						height="152"
						allow="
								encrypted-media;
								picture-in-picture;
							"
						loading="lazy"
						allowfullscreen>
					</iframe>
				</div>
			</section>
			<section class="about-section" id="identity">
				<h2 class="text-cosmic-adaptive-purple my-4 text-2xl">
					Identity
				</h2>
				<p class="ul-paragraph">
					<strong>Pronouns:</strong>
				</p>
				<ul id="pronouns-list">
					{
						pronouns.map(({ name, lang, list }) => {
							return (
								<li>
									<strong>{name}:</strong>
									{list.map(({ link, pronouns }) => (
										<PronounsLink
											{lang}
											{link}
											{pronouns}
										/>
									))}
								</li>
							);
						})
					}
				</ul>
				<p>
					<strong>Role:</strong>
					Fullstack Web Developer (Front-end a11y first)
				</p>
				<p class="ul-paragraph"><strong>Languages:</strong></p>
				<ul>
					{
						languages.map(({ level, langs, abbr }) => (
							<li>
								<strong>
									{abbr ? (
										<abbr class="text-inherit" title={abbr}>
											{level + ":"}
										</abbr>
									) : (
										level + ":"
									)}
								</strong>
								{" " + langs.join(" ")}
							</li>
						))
					}
				</ul>
				<p>Furry · Tech Nerd</p>
				<p>Multifandom · Cosmic‑aligned</p>
				<p>Dark softie · Whimsigoth touch</p>
				<p>Autistic (level 1) · High abilities / gifted</p>
				<p>You only know a few things... but there's still more.</p>
			</section>
		</main>
		<aside
			class="text-cosmic-light border-border mx-10 my-0 flex flex-col items-center gap-0 border-t border-solid p-4 text-center text-sm *:my-1">
			<p>
				<strong class="font-bold text-red-500">WARNING:</strong> This website
				is still under development. Some pages may be incomplete or not working
				properly. If you find any issues, please report them to me (email:
				<a
					href="mailto:feedback@kaelunyx.space"
					rel="external noopener noreferrer"
					target="_blank"
					class="text-cosmic-adaptive-blue hover:underline"
					>feedback@kaelunyx.space</a
				>).
			</p>
			<p>
				Also, I may change the design and content of this website at any
				time without notice.
			</p>
			<p>
				And I'm fluid, so my description may change too. I may also
				change my pronouns, so please check my <a
					href="https://en.pronouns.page/u/kaelunyx"
					rel="external noopener noreferrer"
					target="_blank"
					class="text-cosmic-adaptive-blue hover:underline"
					>pronouns page</a
				> for the most up-to-date information.
			</p>
		</aside>
		<Footer />
	</div>
</Layout>
